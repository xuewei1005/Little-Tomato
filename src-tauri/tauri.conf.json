{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小番茄",
  "version": "0.2.1",
  "identifier": "com.xiaofanqie.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "小番茄",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "shadow": true
      },
      {
        "label": "pet",
        "title": "小番茄",
        "url": "index.html#pet",
        "width": 260,
        "height": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false
  }
}
